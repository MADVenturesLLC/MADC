{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MADC Desktop",
  "version": "0.0.0",
  "identifier": "com.madventures.madc.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "MADC Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
